;;; init-local-proofread-config.el --- Private proofread endpoint -*- lexical-binding: t -*-
;;; Commentary:

;; Copy this file to `init-local-proofread-config.el' in the same directory and
;; fill in the endpoint you use.  That copy is gitignored, so the host name and
;; the model name stay out of the repository.
;;
;; The API key itself is never stored here.  Put it in ~/.authinfo instead:
;;
;;   machine ENDPOINT-HOST login apikey password YOUR-KEY
;;
;; and keep that file at mode 600.

;;; Code:

(setq my/proofread-endpoint-url "https://ENDPOINT-HOST/v1/")
(setq my/proofread-auth-host "ENDPOINT-HOST")
(setq my/proofread-auth-user "apikey")
(setq my/proofread-chat-model "MODEL-NAME")
(setq my/proofread-provider-identity "PROVIDER:MODEL")
(setq my/proofread-source-label "MODEL")

;; Uncomment and fill in only when MODEL-NAME needs non-standard chat
;; parameters, such as a reasoning effort or a pinned OpenRouter route.
;; (setq my/proofread-chat-params
;;       '((reasoning . ((effort . "low")))))

;; Uncomment and fill in only when `llm' does not already know MODEL-NAME.
;; See `llm-models-add' for the full argument list.  `llm-models-match'
;; downcases the requested model before testing :regex against it, so
;; write the regex against the lowercase form of MODEL-NAME.
;; (setq my/proofread-model-metadata
;;       (list :name "MODEL-NAME"
;;             :symbol 'my/model
;;             :capabilities '(generation json-response)
;;             :context-length 128000
;;             :regex "model-name\\'"))

;; `my/llm-proof' follows the model above by default and still sends
;; `my/proofread-chat-params' with every request.  Uncomment this to
;; proofread selected text with a different model.
;; (setq my/llm-proof-model "OTHER-MODEL-NAME")

(provide 'init-local-proofread-config)
;;; init-local-proofread-config.el ends here
